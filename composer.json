{
    "name": "webgraphx/formula-price-sync",
    "description": "Professional gold & currency-based dynamic pricing for WooCommerce",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "WebGraphx",
            "email": "info@webgraphx.ir",
            "homepage": "https://webgraphx.ir"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "brain/monkey": "^2.6",
        "wp-coding-standards/wpcs": "^3.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "FormulaPriceSync\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FormulaPriceSync\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "lint": "phpcs --standard=WordPress includes/ tests/",
        "lint:fix": "phpcbf --standard=WordPress includes/ tests/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}